---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us - UTM Link Builder" 
  description="Get in touch with the team behind UTM Link Builder."
>
  <div class="max-w-3xl mx-auto w-full px-6 prose prose-invert">
    <h1 class="text-3xl font-bold text-white mb-6">Contact Us</h1>
    <p>We'd love to hear from you!</p>
    <p>Whether you have a question about the tool, a feature request, or just want to say hello, feel free to reach out.</p>
    
    <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-lg mt-8">
      <h3 class="text-xl font-semibold text-white mt-0">Email Us</h3>
      <p class="mb-0">You can reach us at: <a href="mailto:support@utmbuilder-pro.pages.dev" class="text-indigo-400 hover:text-indigo-300">support@utmbuilder-pro.pages.dev</a></p>
    </div>
  </div>
</Layout>
